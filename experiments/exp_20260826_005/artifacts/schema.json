    "claimed_release_interval_ms",
    "interval_counts",
    "expected_interval_counts"
  ],
  "inventory_key": [
    "catalog_id",
    "article_id_type",
    "article_id",
    "article_code"
  ],
  "list_response_locator": "$.data.catalogs[0]",
  "processed_artifacts": [
    "inventory.jsonl",
    "detail_index.jsonl",
    "time_claim_discrepancies.jsonl",
